# Copy to .env and fill in. Never commit .env.

POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgres://upstream:change-me-long-random@db:5432/upstream

# Salt for hashing author ids. Set once and never change it,
# or author counts stop matching across days.
AUTHOR_SALT=change-me-another-long-random

# Bluesky Jetstream. Any public instance works; the collector resumes
# from its saved cursor after a restart.
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
JETSTREAM_LANGS=en

# Contact email sent with requests, as Wikimedia and some publishers ask bots to do.
BOT_CONTACT_EMAIL=

# Free API keys. Each source switches on when its key is filled in.
# News headlines and Wikipedia need no key and are always on.
YOUTUBE_API_KEY=
YOUTUBE_REGIONS=US,GB,CA,AU
TUMBLR_API_KEY=
GIPHY_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# How many mentions in 24h a tier needs before it counts toward breadth.
# Smaller sources get smaller bars.
MIN_TIER_MENTIONS_24H=inner:20,middle:5,outer:3

# Signal thresholds.
# Ignore terms below this daily volume:
MIN_MENTIONS_24H=40
# Ignore terms pushed by only a handful of accounts:
MIN_AUTHORS_12H=15
# +150% vs the same window yesterday counts as a breakout:
BREAKOUT_VELOCITY=1.5

# Optional Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The terminal sends this as a Bearer token to the API.
API_TOKEN=change-me-api-token
